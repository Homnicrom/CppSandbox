{
  "version": "0.2.0",
  "configurations": [
    {
      // Debugs whichever target the CMake Tools status bar has selected, so one entry covers all.
      "name": "Debug selected CMake target (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      // The target's own output folder: LangCatalog opens languages.txt by relative path
      // from next to its binary.
      "cwd": "${command:cmake.launchTargetDirectory}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Pretty-print std:: containers",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
